    { "key": "donationTransactionId", "value": "" },
    { "key": "approveWithdrawRequestId", "value": "" },
    { "key": "rejectWithdrawRequestId", "value": "" }
  ],
  "item": [
    {
      "name": "00 Auth - Login ADMIN reader02",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"identifier\": \"{{adminIdentifier}}\",\n  \"password\": \"{{password}}\"\n}" },
        "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "const json = pm.response.json();",
        "pm.test('ADMIN login returns 200', () => pm.response.to.have.status(200));",
        "pm.test('reader02 role is ADMIN', () => pm.expect(json.data.user.role).to.eql('ADMIN'));",
        "pm.collectionVariables.set('adminToken', json.data.accessToken);",
        "pm.collectionVariables.set('adminUserId', json.data.user.userId);"
      ] } }]
    },
    {
      "name": "01 Auth - Login AUTHOR reader03",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
