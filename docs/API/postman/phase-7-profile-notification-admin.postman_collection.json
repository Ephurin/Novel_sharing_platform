    {
      "name": "03 Profile - Get Author Profile",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/authors/{{authorId}}/profile", "host": ["{{baseUrl}}"], "path": ["authors", "{{authorId}}", "profile"] }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "const json = pm.response.json();",
        "pm.test('author profile returns 200', () => pm.response.to.have.status(200));",
        "pm.test('author profile matches authorId', () => pm.expect(json.data.authorId).to.eql(pm.collectionVariables.get('authorId')));",
        "pm.test('author profile has novels array', () => pm.expect(json.data.novels).to.be.an('array'));",
        "pm.test('followersCount is numeric', () => pm.expect(json.data.followersCount).to.be.a('number'));"
      ] } }]
    },
    {
      "name": "04 Notifications - List Mine",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{readerToken}}" }],
        "url": {
          "raw": "{{baseUrl}}/notifications?page=1&limit=20",
          "host": ["{{baseUrl}}"],
          "path": ["notifications"],
          "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "20" }]
        }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "const json = pm.response.json();",
        "pm.test('notifications list returns 200', () => pm.response.to.have.status(200));",
        "pm.test('notifications data is array', () => pm.expect(json.data).to.be.an('array'));",
        "pm.test('notifications response has pagination meta', () => pm.expect(json.meta).to.have.property('totalItems'));",
        "if (json.data.length > 0) pm.collectionVariables.set('notificationId', json.data[0].notificationId);"
      ] } }]
    },
    {
      "name": "05 Notifications - Register Device Token",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{readerToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"provider\": \"WEB_PUSH\",\n  \"platform\": \"WEB\",\n  \"deviceToken\": \"phase-7-postman-device-token-{{$timestamp}}\"\n}" },
        "url": { "raw": "{{baseUrl}}/notifications/device-token", "host": ["{{baseUrl}}"], "path": ["notifications", "device-token"] }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "const json = pm.response.json();",
        "pm.test('device token returns 200', () => pm.response.to.have.status(200));",
        "pm.test('device token registered', () => pm.expect(json.data.registered).to.eql(true));",
        "pm.test('provider is WEB_PUSH', () => pm.expect(json.data.provider).to.eql('WEB_PUSH'));"
      ] } }]
    },
    {
      "name": "06 Notifications - Mark Read Optional",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Authorization", "value": "Bearer {{readerToken}}" }],
        "url": { "raw": "{{baseUrl}}/notifications/{{notificationId}}/read", "host": ["{{baseUrl}}"], "path": ["notifications", "{{notificationId}}", "read"] }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "const json = pm.response.json();",
        "pm.test('mark read returns 200 if seeded, otherwise 404', () => pm.expect([200, 404]).to.include(pm.response.code));",
        "if (pm.response.code === 200) pm.test('notification status is READ', () => pm.expect(json.data.status).to.eql('READ'));",
        "if (pm.response.code === 404) pm.test('no notification seed is acceptable', () => pm.expect(json.error.code).to.eql('NOT_FOUND_001'));"
      ] } }]
    },
