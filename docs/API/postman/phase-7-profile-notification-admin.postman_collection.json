{
  "info": {
    "name": "Ephurin Phase 7 - Profile, Notification, Admin Backend APIs",
    "_postman_id": "6c5a7b81-5d25-4fe7-a7e7-phase7admin",
    "description": "Postman collection for Phase 7 review. Uses reader02 as ADMIN, reader03 as AUTHOR, reader04 as READER. Withdraw review tests create mock wallet data first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api/v1" },
    { "key": "adminIdentifier", "value": "reader02" },
    { "key": "authorIdentifier", "value": "reader03" },
    { "key": "readerIdentifier", "value": "reader04" },
    { "key": "password", "value": "StrongPassword123!" },
    { "key": "notificationId", "value": "00000000-0000-0000-0000-000000000000" },
    { "key": "adminToken", "value": "" },
    { "key": "authorToken", "value": "" },
    { "key": "readerToken", "value": "" },
    { "key": "adminUserId", "value": "" },
