# Copy to .env.demo in the repository root; .env.demo is ignored by Git.
# Add ONE valid Gemini API key locally. NEVER commit the real value.
GEMINI_API_KEY=
DEMO_LLM_MODEL=gemini-3.5-flash-lite

# Optional: configure semantic retrieval only after the demo story already
# has compatible 768-dimensional Gemini embeddings and persistent memory.
# EMBEDDING_PROVIDER=gemini
# SEMANTIC_RETRIEVAL_ENABLED=true
# ACTIVE_EMBEDDING_VERSION=gemini-embedding-2-768-v1
