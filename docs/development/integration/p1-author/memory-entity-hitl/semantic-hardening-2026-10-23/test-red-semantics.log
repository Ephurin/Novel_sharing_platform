flow = namespace(repo=<infrastructure.postgres_narrative_repository.PostgresNarrativeRepository object at 0x0000026F77FAF200>...00026F77FDA870>, engine=Engine(postgresql+psycopg://postgres@127.0.0.1:20700/ephurin_test_astra_p1_semantics_35be1a69))

    def test_parallel_continue_commits_one_proposal_set(flow):
        if not flow.engine:
            pytest.skip('Row-lock concurrency requires PostgreSQL')
        f = flow
        run, audit = discover(f)
        freeze(f, run, audit)
        from concurrent.futures import ThreadPoolExecutor
        from threading import Barrier
        from application.entity_hitl import continue_review
        barrier = Barrier(2)
        original = f.llm._call_structured
        def synchronized(**kwargs):
            if kwargs['operation'] == 'hitl_event_extraction':
                barrier.wait(timeout=10)
            return original(**kwargs)
        f.llm._call_structured = synchronized
        with ThreadPoolExecutor(max_workers=2) as pool:
