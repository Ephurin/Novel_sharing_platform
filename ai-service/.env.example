SERVICE_NAME="AI Service - Story Platform"
SERVICE_VERSION=1.0.0

LLM_ENABLED=false
LLM_PROVIDER=none
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30
# JSON extraction budget; prose suggestions retain their separate default.
LLM_STRUCTURED_MAX_TOKENS=8192

GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

NARRATIVE_REPOSITORY=postgres
JSON_REPOSITORY_MODE=read-only
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/novel_platform
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
DEFAULT_ACTOR_ID=00000000-0000-0000-0000-000000000001

# Phase 7 semantic retrieval (safe rollout: disabled by default)
SEMANTIC_RETRIEVAL_ENABLED=false
EMBEDDING_PROVIDER=none
ACTIVE_EMBEDDING_VERSION=
SEMANTIC_RETRIEVAL_LIMIT=8
CONTEXT_ROUTING_POLICY=legacy-v1

PLATFORM_API_BASE_URL=
PLATFORM_SERVICE_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

ENTITY_PIPELINE_VERSION=entity-v1
ENTITY_PROMPT_VERSION=entity-extraction-v1
