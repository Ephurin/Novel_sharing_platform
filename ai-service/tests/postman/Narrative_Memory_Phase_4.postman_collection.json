        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"novel_id\": \"{{novelId}}\",\n  \"chapter_id\": \"{{chapterId}}\",\n  \"content_hash\": \"{{contentHash}}\",\n  \"operation\": \"different_operation\",\n  \"options\": {\n    \"extract_entities\": false\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/revisions/{{revisionId}}/analyses",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "revisions", "{{revisionId}}", "analyses"]
        }
      }
    },
    {
      "name": "04 - Content hash sai (422 CONTENT_HASH_MISMATCH)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 422 Unprocessable Entity', function () {",
              "    pm.response.to.have.status(422);",
              "});",
              "var json = pm.response.json();",
              "pm.test('Error code is CONTENT_HASH_MISMATCH', function () {",
