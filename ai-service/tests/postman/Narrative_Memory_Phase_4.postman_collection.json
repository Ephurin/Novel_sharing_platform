{
  "info": {
    "_postman_id": "7d9e2a44-f25b-4395-8889-61b402eb0623",
    "name": "Narrative Memory Phase 4 - Acceptance & Projection",
    "description": "Complete test suite for Phase 4: revision -> proposals -> author acceptance -> projection -> correction -> rebuild on PostgreSQL.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 - Khởi tạo Novel & Revision fixture trên Mock Platform",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var novelId = pm.variables.replaceIn('{{$guid}}');",
              "var chapterId = pm.variables.replaceIn('{{$guid}}');",
              "var revisionId = pm.variables.replaceIn('{{$guid}}');",
              "var contentText = 'Tiêu Viêm thi triển Dị Hỏa đối đầu Hải Ba Đông tại sa mạc Tháp Qua Nhĩ. Sau một hồi kịch chiến dữ dội, Hải Ba Đông bị thương nặng và suy giảm sức chiến đấu.';",
              "var CryptoJS = require('crypto-js');",
              "var contentHash = CryptoJS.SHA256(contentText).toString(CryptoJS.enc.Hex);",
              "pm.environment.set('novelId', novelId);",
              "pm.environment.set('chapterId', chapterId);",
              "pm.environment.set('revisionId', revisionId);",
              "pm.environment.set('contentText', contentText);",
              "pm.environment.set('contentHash', contentHash);",
              "pm.environment.set('brainVersion', '1');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"revision_id\": \"{{revisionId}}\",\n  \"novel_id\": \"{{novelId}}\",\n  \"chapter_id\": \"{{chapterId}}\",\n  \"content\": \"{{contentText}}\",\n  \"tenant_id\": \"{{tenantId}}\"\n}"
        },
        "url": {
          "raw": "{{mockPlatformUrl}}/internal/v1/revisions",
          "host": ["{{mockPlatformUrl}}"],
          "path": ["internal", "v1", "revisions"]
        }
      }
    },
    {
      "name": "01 - Phân tích revision (Chưa có canonical state trước acceptance)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set('idempotencyKey', 'run-' + Date.now());",
              "pm.environment.set('requestId', 'req-' + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 202 Accepted', function () {",
              "    pm.response.to.have.status(202);",
              "});",
              "var json = pm.response.json();",
              "pm.test('Analysis run completed with proposals', function () {",
              "    pm.expect(json.data.status).to.eql('completed');",
              "    pm.expect(json.data.deduplicated).to.be.false;",
              "    pm.expect(json.data.proposal_count).to.be.above(0);",
              "});",
              "pm.environment.set('analysisRunId', json.data.analysis_run_id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {"key": "X-Tenant-Id", "value": "{{tenantId}}"},
          {"key": "X-Request-Id", "value": "{{requestId}}"},
          {"key": "Idempotency-Key", "value": "{{idempotencyKey}}"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"novel_id\": \"{{novelId}}\",\n  \"chapter_id\": \"{{chapterId}}\",\n  \"content_hash\": \"{{contentHash}}\",\n  \"operation\": \"chapter_analysis\",\n  \"options\": {\n    \"extract_entities\": true,\n    \"extract_events\": true,\n    \"extract_state_transitions\": true\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/revisions/{{revisionId}}/analyses",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "revisions", "{{revisionId}}", "analyses"]
        }
      }
    },
    {
      "name": "01b - Kiểm tra chưa có canonical state trước khi accept",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var json = pm.response.json();",
              "pm.test('Canonical state is empty before acceptance', function () {",
              "    pm.expect(json.data.entities).to.be.empty;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/story-brains/{{novelId}}/state",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "story-brains", "{{novelId}}", "state"]
        }
      }
    },
    {
      "name": "02 - Phân tích lại với cùng input và idempotency key (Deduplicated)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 202 Accepted', function () {",
              "    pm.response.to.have.status(202);",
              "});",
              "var json = pm.response.json();",
              "pm.test('Response is deduplicated and returns same run_id', function () {",
              "    pm.expect(json.data.deduplicated).to.be.true;",
              "    pm.expect(json.data.analysis_run_id).to.eql(pm.environment.get('analysisRunId'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {"key": "X-Tenant-Id", "value": "{{tenantId}}"},
          {"key": "X-Request-Id", "value": "req-repeat"},
          {"key": "Idempotency-Key", "value": "{{idempotencyKey}}"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"novel_id\": \"{{novelId}}\",\n  \"chapter_id\": \"{{chapterId}}\",\n  \"content_hash\": \"{{contentHash}}\",\n  \"operation\": \"chapter_analysis\",\n  \"options\": {\n    \"extract_entities\": true,\n    \"extract_events\": true,\n    \"extract_state_transitions\": true\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/revisions/{{revisionId}}/analyses",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "revisions", "{{revisionId}}", "analyses"]
        }
      }
    },
    {
      "name": "03 - Dùng cùng idempotency key nhưng khác input (409 IDEMPOTENCY_CONFLICT)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 409 Conflict', function () {",
