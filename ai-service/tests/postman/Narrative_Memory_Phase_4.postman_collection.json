    {
      "name": "12c - Lấy proposal group của event về sau",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);",
              "var proposals = pm.response.json().data.filter(p => p.analysis_run_id === pm.environment.get('laterAnalysisRunId'));",
              "pm.expect(proposals.length).to.be.above(0);",
              "var group = proposals[0].dependency_group_id;",
              "pm.environment.set('laterGroupId', group);",
              "pm.environment.set('laterProposalIds', JSON.stringify(proposals.filter(p => p.dependency_group_id === group).map(p => p.proposal_id)));",
              "pm.environment.set('laterEventId', proposals.find(p => p.proposal_type === 'event').proposal_id);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{"key": "X-Request-Id", "value": "req-later-proposals"}],
        "url": {
          "raw": "{{baseUrl}}/v1/story-brains/{{novelId}}/proposals?status=pending",
