    {
      "name": "12a - Tạo revision cho event xảy ra về sau",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var CryptoJS = require('crypto-js');",
              "var laterRevisionId = pm.variables.replaceIn('{{$guid}}');",
              "var laterContent = 'Tieu Viem va Hai Ba Dong pha tran phap tai Mac Gia.';",
              "pm.environment.set('laterRevisionId', laterRevisionId);",
              "pm.environment.set('laterContent', laterContent);",
              "pm.environment.set('laterContentHash', CryptoJS.SHA256(laterContent).toString(CryptoJS.enc.Hex));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.response.to.have.status(201);"]
