    {
      "name": "12 - Đọc state sau correction (Phản ánh đúng replay 70)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var json = pm.response.json();",
              "pm.test('State has health attribute updated to 70', function () {",
              "    var hasHealth70 = false;",
              "    for (var k in json.data.entities) {",
              "        if (json.data.entities[k].health === 70) {",
              "            hasHealth70 = true;",
              "            break;",
              "        }",
              "    }",
              "    pm.expect(hasHealth70).to.be.true;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/story-brains/{{novelId}}/state",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "story-brains", "{{novelId}}", "state"]
