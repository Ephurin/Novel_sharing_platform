              "    pm.expect(json.detail.code).to.eql('IDEMPOTENCY_CONFLICT');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {"key": "X-Tenant-Id", "value": "{{tenantId}}"},
