    {
      "name": "06 - Đọc canonical state (Giá trị đúng & có provenance)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var json = pm.response.json();",
              "pm.test('State has materialized entities and attributes', function () {",
              "    pm.expect(Object.keys(json.data.entities).length).to.be.above(0);",
              "    pm.expect(Object.keys(json.data.provenance).length).to.be.above(0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/story-brains/{{novelId}}/state",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "story-brains", "{{novelId}}", "state"]
        }
      }
    },
