          "mode": "raw",
          "raw": "{\n  \"proposal_ids\": {{proposalIds}},\n  \"expected_brain_version\": 1,\n  \"reason\": \"Trying stale version\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/proposal-groups/{{dependencyGroupId}}/accept",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "proposal-groups", "{{dependencyGroupId}}", "accept"]
        }
      }
    },
    {
      "name": "08a - Tạo đề xuất transition không hợp lệ (Health = 9999)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var json = pm.response.json();",
              "pm.expect(json.data.length).to.be.above(0);",
              "var invGroup = json.data[0].dependency_group_id;",
              "var invIds = json.data.map(p => p.proposal_id);",
              "pm.environment.set('invGroupId', invGroup);",
              "pm.environment.set('invProposalIds', JSON.stringify(invIds));",
              "pm.environment.set('invProposalId', invIds[0]);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"expected_brain_version\": 2,\n  \"replacement\": {\n    \"event_type\": \"injury\",\n    \"summary\": \"Invalid health transition\",\n    \"participants\": [\"Hải Ba Đông\"],\n    \"chapter\": 1\n  },\n  \"transitions\": [\n    {\n      \"entity_id\": \"Hải Ba Đông\",\n      \"attribute_key\": \"health\",\n      \"new_value\": 9999\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/story-brains/{{novelId}}/events/{{eventId}}/corrections",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "story-brains", "{{novelId}}", "events", "{{eventId}}", "corrections"]
        }
      }
    },
