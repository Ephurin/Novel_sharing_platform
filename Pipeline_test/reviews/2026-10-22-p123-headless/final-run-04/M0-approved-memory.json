    },
    {
      "fact_id": "0c6f2bab-c902-4d65-bdc3-2ebba4ca41fb",
      "subject_entity_id": null,
      "fact_type": "narrative_fact",
      "fact_key": "observed_scene",
      "fact_value": {
        "value": "Chiếc phà chạm bến bằng một tiếng thở dài của sắt. Mai Linh nhận ra âm thanh ấy trước khi nhận ra thành phố. Ở tuổi hai mươi chín, cô vẫn nhớ một tiếng động cũ dễ hơn nhớ đường về nhà.",
        "subject": "",
        "certainty": "confirmed"
      },
