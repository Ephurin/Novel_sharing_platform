    {
      "fact_id": "5e8e88b5-02a0-40c1-a644-b6ecba2bf3a6",
      "subject_entity_id": null,
      "fact_type": "narrative_fact",
      "fact_key": "observed_scene",
      "fact_value": {
        "value": "Bà Sâm bán cháo ở chỗ con hẻm hẹp đến mức hai người mang ô phải nghiêng vai tránh nhau. Trên tường sau bếp có một mảng vôi mới, trắng hơn mọi thứ xung quanh. Linh ngồi xuống ghế thấp, đầu gối gần chạm mặt bàn.",
        "subject": "",
        "certainty": "confirmed"
      },
      "is_locked": false,
      "chapter_number": 3,
      "source_revision_id": "1474b572-a8e2-4fce-a11a-299e8fa6912f",
      "source_start": 0,
      "source_end": 209,
      "supersedes_id": null,
      "is_retired": false
    },
    {
      "fact_id": "77e02b44-23b4-45c9-b87e-30a55bbeba1d",
      "subject_entity_id": null,
      "fact_type": "narrative_fact",
      "fact_key": "observed_scene",
      "fact_value": {
        "value": "Sáng ngày thứ hai, Cồn Vân không mưa. Mặt kênh phẳng đến mức những vết nứt trên tường nhà in xuống nước trông sâu hơn vết thật.",
        "subject": "",
        "certainty": "confirmed"
      },
      "is_locked": false,
      "chapter_number": 4,
      "source_revision_id": "98907e25-8c7d-49a9-ba7a-fb71b29d4013",
      "source_start": 0,
      "source_end": 127,
      "supersedes_id": null,
