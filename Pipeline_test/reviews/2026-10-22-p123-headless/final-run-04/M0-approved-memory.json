      "subject_entity_id": null,
      "fact_type": "narrative_fact",
      "fact_key": "observed_scene",
      "fact_value": {
        "value": "Duy không mở cửa thêm. Anh chèn một miếng gỗ vào khe, buộc dây cảnh báo qua hai trụ lan can rồi bảo Linh lùi về phần sàn có ánh sáng.",
        "subject": "",
        "certainty": "confirmed"
      },
      "is_locked": false,
      "chapter_number": 5,
