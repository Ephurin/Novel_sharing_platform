      ],
      "metadata": {
        "chapter": 1,
        "summary": "Mai Linh arrives at the pottery warehouse and meets storekeeper Hòa.",
        "evidence": [
          {
            "end": 2774,
            "quote": "Kho nằm sau một trường tiểu học đã chuyển đi. Sân có cây bàng bị cắt mất ngọn, vết cắt phủ nhựa đen. Trên cửa, tấm biển “Phòng lưu trữ âm thanh đô thị” mất chữ cuối. Người ra đón cô là ông thủ kho gầy, áo sơ mi cài lệch một nút.",
            "start": 2546,
            "text_hash": "db5d2776dc94535ea3791455e1b811474e6705aaa41ad1408f5fb526d01c0ea7",
            "chapter_id": "940bbdee-fa51-4bb7-8996-4aca4a3dc505",
