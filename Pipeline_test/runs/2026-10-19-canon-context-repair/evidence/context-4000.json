      }
    },
    {
      "event_id": "d63a1e48-2f1a-54c2-b9b5-2fedc9be65d8",
      "narrative_order": 25600,
      "chapter_number": 1,
      "event_type": "contract_signing",
      "summary": "Mai Linh signs a twelve-day contract for inventory and assessment work with Hòa.",
      "participants": [
