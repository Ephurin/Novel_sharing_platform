# Example environment configuration for isolated testing stack (Wave 1C, V1C-04)
# Copy to .env.isolated and populate with local test secrets.
# NEVER commit .env.isolated or real credentials to Git.

# Local database configuration
POSTGRES_DB=p1_ephurin
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_local_secure_postgres_password_here

# JWT authentication secrets for isolated test
JWT_ACCESS_SECRET=your_local_isolated_access_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_local_isolated_refresh_secret_here_min_32_chars
PLATFORM_SERVICE_TOKEN=your_local_isolated_service_token_here

# Author credentials (for test runner)
AUTHOR_USER=p1_author
AUTHOR_PASSWORD=your_local_author_password_here

# Live Google AI Studio Provider API Key
# NOTE: Only needed if live provider testing is authorized by project owner.
# Handled exclusively by budget_gateway container; withheld from worker containers.
GEMINI_API_KEY=
