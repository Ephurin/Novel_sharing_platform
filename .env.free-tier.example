# Ephurin AI Copilot - Google AI Studio Free Tier Runtime Configuration
# Non-secret environment template for P1-LIVE-FREE-01 acceptance
# Copy to .env or load into container environment. NEVER COMMIT REAL API KEYS!

# --- Execution Profile ---
# Options: offline_test | live_free_tier | live_paid
AI_EXECUTION_MODE=live_free_tier

# Operator activation guard (MUST be explicitly set to true after preflight verification)
LIVE_FREE_TIER_ENABLED=false

# Upstream Live Forwarding (false = fake upstream simulation; true = real Gemini egress)
LIVE_UPSTREAM_FORWARDING=false

# --- LLM Provider & Model Selection ---
LLM_PROVIDER=gemini
# Primary approved writing model
LLM_MODEL=gemini-3.5-flash-lite
# Optional verified fallback (gemini-3.1-flash-lite). Gemini 2.5 is STRICTLY FORBIDDEN.
LLM_FALLBACK_PROVIDER=disabled
LLM_FALLBACK_MODEL=disabled
LLM_LOCAL_FALLBACK=false
LLM_STRUCTURED_MAX_TOKENS=8192

# --- Embedding Provider & Model Selection ---
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768
SEMANTIC_RETRIEVAL_ENABLED=true

# --- Guard Proxy & Operator Control Configuration ---
# Workers route ALL AI traffic through the shared budget/quota gateway
BUDGET_GUARD_MODE=proxy
BUDGET_GUARD_URL=http://budget-gateway:18090
BUDGET_GUARD_AUTH_TOKEN=operator-worker-token-secret
OPERATOR_AUTH_TOKEN=operator-emergency-secret-key

# --- Google AI Studio Free Tier Quota Limits (Configured from AI Studio Project) ---
# NOTE: The application CANNOT independently verify billing tier or quota allocations
# from the API key alone. The operator MUST inspect Google AI Studio, confirm Free Tier
# status (0 payment methods attached), attest project status, and supply published project limits below:
FREE_TIER_GEMINI_RPM=<OPERATOR_SUPPLIED_GEMINI_RPM_E_G_15>
FREE_TIER_GEMINI_TPM=<OPERATOR_SUPPLIED_GEMINI_TPM_E_G_250000>
FREE_TIER_GEMINI_RPD=<OPERATOR_SUPPLIED_GEMINI_RPD_E_G_500>

FREE_TIER_EMBEDDING_RPM=<OPERATOR_SUPPLIED_EMBEDDING_RPM_E_G_15>
FREE_TIER_EMBEDDING_TPM=<OPERATOR_SUPPLIED_EMBEDDING_TPM_E_G_1000000>
FREE_TIER_EMBEDDING_RPD=<OPERATOR_SUPPLIED_EMBEDDING_RPD_E_G_500>

# Concurrency & Safety Headroom
FREE_TIER_MAX_CONCURRENCY=2
FREE_TIER_REQUEST_TIMEOUT_SECONDS=30
FREE_TIER_MAX_RETRIES=3
FREE_TIER_QUOTA_HEADROOM=0.10

# --- Canon & HITL Safety Boundaries ---
ENTITY_CANDIDATE_VERIFICATION_ENABLED=true
CANON_EXPLICIT_APPROVAL_REQUIRED=true
PRIVATE_NOTES_STRIPPING_ENABLED=true

