NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
WEB_ORIGIN=http://localhost:5173
DB_CONNECT_ON_START=false
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ephurin
MONGODB_URI=mongodb://localhost:27017/ephurin
JWT_ACCESS_SECRET=replace-with-access-secret
JWT_REFRESH_SECRET=replace-with-refresh-secret
JWT_ACCESS_EXPIRES_SECONDS=3600
JWT_REFRESH_EXPIRES_DAYS=7
REFRESH_TOKEN_COOKIE_NAME=ephurin_refresh_token
GIPHY_API_KEY=
AI_LLM_BASE_URL=
AI_LLM_API_KEY=
AI_LLM_MODEL=local-model
AI_LLM_TIMEOUT_MS=120000
AI_LLM_MAX_TOKENS=2048
AI_LLM_TEMPERATURE=0.7
