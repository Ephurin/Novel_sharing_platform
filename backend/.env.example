NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
WEB_ORIGIN=http://localhost:5173
DB_CONNECT_ON_START=false
NOVEL_SELECTION_ENABLED=false
NOVEL_FEATURED_PLACEMENTS_ENABLED=false
NOVEL_SELECTION_RECONSIDERATION_WRITES_ENABLED=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ephurin
MONGODB_URI=mongodb://localhost:27017/ephurin
JWT_ACCESS_SECRET=replace-with-access-secret
JWT_REFRESH_SECRET=replace-with-refresh-secret
JWT_ACCESS_EXPIRES_SECONDS=3600
JWT_REFRESH_EXPIRES_DAYS=7
REFRESH_TOKEN_COOKIE_NAME=ephurin_refresh_token
# Optional private credential for server-side metadata validation.
GIPHY_API_KEY=
# Browser-visible client credential. Configure provider quotas and restrictions.
GIPHY_PUBLIC_API_KEY=
AI_LLM_BASE_URL=
AI_LLM_API_KEY=
AI_LLM_MODEL=local-model
AI_LLM_TIMEOUT_MS=120000
AI_LLM_MAX_TOKENS=2048
AI_LLM_TEMPERATURE=0.7
PAYMENT_RATE_LIMIT_MAX=30
PAYMENT_RATE_LIMIT_WINDOW_MS=60000
# Coin top-up gateway: mock (internal, offline) or vnpay (VNPay sandbox, no real money).
PAYMENT_GATEWAY=mock
# From the VNPay sandbox registration email. Never commit real values.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Leave empty to use ${WEB_ORIGIN}/wallet/vnpay-return.
VNPAY_RETURN_URL=
VNPAY_SESSION_TTL_MINUTES=15

# Enable only after every backend instance understands comment audiences.
# Disabling this flag blocks new private roots/replies but keeps read authorization enforced.
PRIVATE_COMMENTS_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
# Optional. Set the private hostname or the exact address of the nginx auth proxy.
AUTH_TRUSTED_PROXY_HOST=
# Password registration requires a sender. Use smtp://localhost:1026 for the local Mailpit profile.
SMTP_URL=
# Or set the following fields instead of SMTP_URL. Port 465 uses implicit TLS.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
