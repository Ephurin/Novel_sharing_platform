      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authorAccessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Postman Demo Story {{$timestamp}}\",\n  \"description\": \"Story created during API testing presentation\",\n  \"genre\": \"Demo\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/stories/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "stories",
            ""
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "var data = pm.response.json();",
              "pm.test('Create story response has id and title', function () {",
              "    pm.expect(data.id).to.be.a('number');",
              "    pm.expect(data.title).to.be.a('string');",
              "});",
              "",
              "pm.environment.set('storyId', data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - v1 stories should not include ai_summary",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authorAccessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/stories/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "stories",
            ""
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "function getResults(data) {",
              "    if (Array.isArray(data)) return data;",
              "    if (data && Array.isArray(data.results)) return data.results;",
              "    return [];",
              "}",
              "",
              "var data = pm.response.json();",
              "var items = getResults(data);",
              "var storyId = Number(pm.environment.get('storyId'));",
              "var target = items.find(function (x) { return Number(x.id) === storyId; });",
              "pm.test('Created story exists in v1 list', function () {",
              "    pm.expect(target).to.exist;",
              "});",
              "",
              "pm.test('v1 story does not have ai_summary', function () {",
              "    pm.expect(target).to.not.have.property('ai_summary');",
              "});"
            ]
          }
        }
      ]
    },
