{
  "info": {
    "_postman_id": "1d09d2f5-98cd-4c11-9c62-7fa0c117d6d5",
    "name": "API Testing Demo 5-10 Min",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Unauthorized stories list should return 401",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/stories/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "stories",
            ""
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 401', function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "",
              "var data = pm.response.json();",
              "pm.test('Error payload has normalized shape', function () {",
              "    pm.expect(data).to.have.property('error');",
              "    pm.expect(data).to.have.property('message');",
              "    pm.expect(data).to.have.property('status');",
              "    pm.expect(data.status).to.eql(401);",
              "});"
            ]
          }
        }
      ]
    },
    {
