    {
      "name": "11 - Reader can read approved chapters (200)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{readerAccessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/chapters/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "chapters",
            ""
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);",
              "function getResults(data) {",
              "  if (Array.isArray(data)) return data;",
              "  if (data && Array.isArray(data.results)) return data.results;",
              "  return [];",
              "}",
              "var data = pm.response.json();",
              "var items = getResults(data);",
              "var chapterId = Number(pm.environment.get('chapterId'));",
              "var target = items.find(function (x) { return Number(x.id) === chapterId; });",
              "pm.test('Approved chapter visible to reader', function () {",
              "  pm.expect(target).to.exist;",
              "  pm.expect(target.status).to.eql('approved');",
              "});"
            ]
          }
        }
      ]
    },
