  "item": [
    {
      "name": "01 - Unauthorized stories list returns 401",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/stories/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "stories",
            ""
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 401', function () {",
              "  pm.response.to.have.status(401);",
              "});",
              "var data = pm.response.json();",
              "pm.test('Normalized error payload', function () {",
              "  pm.expect(data.status).to.eql(401);",
              "  pm.expect(data).to.have.property('error');",
              "  pm.expect(data).to.have.property('message');",
              "});"
            ]
          }
        }
      ]
    },
